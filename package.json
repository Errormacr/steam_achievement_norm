{
  "name": "steamachview",
  "productName": "steamachview",
  "version": "1.0.0",
  "description": "Electron client for browsing and normalising Steam achievement statistics",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package --arch=x64 --platform=win32",
    "make": "electron-forge make --platform=win32",
    "publish": "electron-forge publish",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "keywords": [],
